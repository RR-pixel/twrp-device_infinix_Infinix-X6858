From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Rama Bondan Prakoso <ramanarubp@gmail.com>
Date: Tue, 3 Nov 2026 15:20:00 +0000
Subject: [PATCH] Haptics: probe vibrator_single, vibrator and brightness

X6855 has no timed_output node. Depending on the haptic driver version the
LED classdev is either vibrator_single (AWINIC aw862xx) or vibrator with a
duration/activate pair, while MTK regulator-vibrator only exposes brightness.
Probe all of them before falling back to evdev force feedback.
---
diff --git a/twrpminui/events.cpp b/twrpminui/events.cpp
index b98d4cd..0d34257 100644
--- a/twrpminui/events.cpp
+++ b/twrpminui/events.cpp
@@ -33,6 +33,7 @@
 #include <string.h>
 #include <fstream>
 #include <mutex>
+#include <thread>
 #include "force_feedback.h"
 #ifdef USE_QTI_AIDL_HAPTICS_FIX_OFF
 #include <thread>
@@ -72,6 +73,9 @@ static std::atomic_int vib_on_count = 0;
 
 #define LEDS_HAPTICS_DURATION_FILE	"/sys/class/leds/vibrator/duration"
 #define LEDS_HAPTICS_ACTIVATE_FILE	"/sys/class/leds/vibrator/activate"
+#define LEDS_HAPTICS_SINGLE_DURATION_FILE	"/sys/class/leds/vibrator_single/duration"
+#define LEDS_HAPTICS_SINGLE_ACTIVATE_FILE	"/sys/class/leds/vibrator_single/activate"
+#define LEDS_HAPTICS_BRIGHTNESS_FILE	"/sys/class/leds/vibrator/brightness"
 
 #ifndef SYN_REPORT
 #define SYN_REPORT          0x00
@@ -270,11 +274,22 @@ int vibrate(int timeout_ms)
         write_to_file(VIBRATOR_TIMEOUT_FILE, tout);
     }
 #else
-    if (std::ifstream(LEDS_HAPTICS_ACTIVATE_FILE).good()) {
+    if (std::ifstream(LEDS_HAPTICS_SINGLE_ACTIVATE_FILE).good()) {
+        write_to_file(LEDS_HAPTICS_SINGLE_DURATION_FILE, tout);
+        write_to_file(LEDS_HAPTICS_SINGLE_ACTIVATE_FILE, "1");
+    } else if (std::ifstream(LEDS_HAPTICS_ACTIVATE_FILE).good()) {
         write_to_file(LEDS_HAPTICS_DURATION_FILE, tout);
         write_to_file(LEDS_HAPTICS_ACTIVATE_FILE, "1");
     } else if (access(VIBRATOR_TIMEOUT_FILE, W_OK) == 0) {
         write_to_file(VIBRATOR_TIMEOUT_FILE, tout);
+    } else if (access(LEDS_HAPTICS_BRIGHTNESS_FILE, W_OK) == 0) {
+        /* MTK regulator-vibrator exposes only a brightness attribute; pulse it
+           in the background so the UI thread is not blocked. */
+        std::thread([timeout_ms] {
+            write_to_file(LEDS_HAPTICS_BRIGHTNESS_FILE, "255");
+            usleep(timeout_ms * 1000);
+            write_to_file(LEDS_HAPTICS_BRIGHTNESS_FILE, "0");
+        }).detach();
     } else {
         return twrpminui::play_force_feedback(timeout_ms);
     }
@@ -299,8 +314,10 @@ int haptics_available()
     return access(VIBRATOR_TIMEOUT_FILE, W_OK) == 0;
 #else
     return twrpminui::force_feedback_available() ||
+           access(LEDS_HAPTICS_SINGLE_ACTIVATE_FILE, W_OK) == 0 ||
            access(LEDS_HAPTICS_ACTIVATE_FILE, W_OK) == 0 ||
-           access(VIBRATOR_TIMEOUT_FILE, W_OK) == 0;
+           access(VIBRATOR_TIMEOUT_FILE, W_OK) == 0 ||
+           access(LEDS_HAPTICS_BRIGHTNESS_FILE, W_OK) == 0;
 #endif
 }
 
